QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=<qdrant-api-key>
QDRANT_TIMEOUT_SECONDS=10
AUTH_ENFORCE=true
FIREBASE_PROJECT_ID=actiwell-74477
FIREBASE_STORAGE_BUCKET=actiwell-74477.firebasestorage.app
PREVIEW_URL_TTL_MINUTES=15

# CORS (required when calling backend from a browser-based frontend)
# CORS_ALLOW_ORIGINS=https://frontend.example.com,https://another.example.com
# Regex is useful for Vercel preview URLs (example: https://frontend-<hash>.vercel.app)
# CORS_ALLOW_ORIGIN_REGEX=^https://frontend-.*\\.vercel\\.app$

# Exactly one credential source is required when AUTH_ENFORCE=true in runtime env:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json

# Optional for scripts/seed_and_test_qdrant.py
# QDRANT_TEST_COLLECTION=spai_smoke_test
# QDRANT_TEST_KEEP_COLLECTION=false
